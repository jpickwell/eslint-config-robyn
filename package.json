		"eslint-plugin-fp": "^2.3.0",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-jsdoc": "^46.8.2",
		"eslint-plugin-lodash-f": "^7.5.3",
		"eslint-plugin-markdown": "^3.0.1",
		"eslint-plugin-n": "^16.2.0",
		"eslint-plugin-no-use-extend-native": "^0.5.0",
		"eslint-plugin-prettier": "^5.0.1",
		"eslint-plugin-promise": "^6.1.1",
		"eslint-plugin-security": "^1.7.1",
		"eslint-plugin-tsdoc": "^0.2.17",
		"eslint-plugin-unicorn": "^48.0.1",
		"eslint-plugin-vitest": "^0.3.3",
		"eslint-plugin-vue": "^9.17.0",
		"eslint-plugin-you-dont-need-lodash-underscore": "^6.13.0",
		"futil": "^1.76.0",
		"glob": "^10.3.10",
		"globals": "^13.23.0",
		"lodash": "^4.17.21",
		"prettier": "^3.0.3",
		"read-pkg-up": "^10.1.0",
		"synchronized-promise": "^0.3.1",
		"typescript": "^5.2.2"
	},
	"description": "Robyn Style - Shareable Configs",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.12.2",
		"@changesets/cli": "^2.26.2",
		"@commitlint/cli": "^17.8.1",
		"@commitlint/config-conventional": "^17.8.1",
		"@turbo/gen": "^1.10.16",
		"@types/eslint": "^8.44.6",
		"@types/lodash": "^4.14.200",
		"@types/node": "^20.8.7",
		"eslint-config-prettier": "^9.0.0",
		"eslint-define-config": "~1.23.0",
		"eslint-find-rules": "^4.1.0",
		"ignore-sync": "^7.0.1",
		"node-gyp": "^9.4.0",
		"pinst": "^3.0.0",
		"postcss": "^8.4.31",
		"postcss-html": "^1.5.0",
		"postcss-scss": "^4.0.9",
		"publint": "^0.2.5",
		"standard-version": "^9.5.0",
		"ts-node": "^10.9.1",
		"tsup": "^7.2.0",
		"tsx": "^3.14.0",
		"turbo": "^1.10.16",
		"vue-eslint-parser": "^9.3.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"onFail": "error",
			"version": "^10.8.2"
		},
		"runtime": {
			"name": "node",
			"onFail": "error",
			"version": "^20.19.2"
		}
	},
	"engines": {
		"node": ">= 20",
		"npm": ">= 10"
	},
	"engineStrict": true,
	"files": [
		"CHANGELOG.md",
		"index.js",
		"src",
		"README.md"
	],
	"homepage": "https://github.com/jpickwell/eslint-config-robyn",
	"keywords": [
		"comment",
		"eslint",
		"functional",
		"import",
		"javascript",
		"jsdoc",
		"lodash",
		"markdown",
		"node",
		"prettier",
		"promise",
		"security",
		"tsdoc",
		"typescript",
		"unicorn",
		"vitest",
		"vue",
		"you-dont-need"
	],
	"license": "MIT",
	"main": "./index.js",
	"name": "eslint-config-robyn",
	"packageManager": "npm@10.8.2",
	"peerDependencies": {
		"vue-eslint-parser": "^9.0.2"
	},
	"peerDependenciesMeta": {
		"vue-eslint-parser": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"readme": "https://github.com/jpickwell/eslint-config-robyn#readme",
	"repository": "github:jpickwell/eslint-config-robyn",
	"scripts": {
		"check:deprecated-rules": "scripts/build-full-config.js && tests/deprecated.js",
		"eslint": "tsx node_modules/eslint/bin/eslint.js",
		"eslint:config": "npm run eslint -- --print-config",
		"eslint:fix": "npm run eslint:lint -- --fix",
		"eslint:lint": "npm run eslint -- -f pretty --color --no-error-on-unmatched-pattern",
		"format": "npm run prettier:write .",
		"format:check": "npm run prettier:check .",
		"ignore-sync": "ignore-sync .",
		"lint": "echo 'Linting ...'; npm run eslint:lint .",
		"lint:config": "npm run eslint:config ./index.js",
		"prettier": "prettier -u",
		"prettier:check": "npm run prettier -- -c",
		"prettier:write": "npm run prettier -- -w",
		"reinstall": "rm -fr node_modules && npm install",
		"release": "bin/release.sh",
		"test": "scripts/test.sh"
	},
	"type": "module",
	"version": "6.4.0"
}
